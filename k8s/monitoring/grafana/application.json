{
  "uid": "repairdesk-overview",
  "title": "Repair Desk — обзор и SLA",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "repair-desk",
    "RED",
    "Go"
  ],
  "timezone": "browser",
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "API: доступные targets",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{namespace=\"repair-desk\",app=\"api\"})",
          "legendFormat": "{{pod}} {{status}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "description": ""
    },
    {
      "id": 2,
      "title": "Пробер: последний результат",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(repairdesk_probe_success{namespace=\"repair-desk\",app=\"prober\"})",
          "legendFormat": "{{pod}} {{status}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "description": ""
    },
    {
      "id": 3,
      "title": "RPS по статусам",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(repairdesk_http_request_duration_seconds_count{namespace=\"repair-desk\",app=\"api\",route=~\".* /api/.*\"}[$__rate_interval]))",
          "legendFormat": "{{pod}} {{status}}",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": ""
    },
    {
      "id": 4,
      "title": "Доля ошибок 5xx",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(repairdesk_http_request_duration_seconds_count{namespace=\"repair-desk\",app=\"api\",route=~\".* /api/.*\",status=~\"5..\"}[$__rate_interval])) or vector(0)) / sum(rate(repairdesk_http_request_duration_seconds_count{namespace=\"repair-desk\",app=\"api\",route=~\".* /api/.*\"}[$__rate_interval]))",
          "legendFormat": "{{pod}} {{status}}",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": ""
    },
    {
      "id": 5,
      "title": "Задержка API p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(repairdesk_http_request_duration_seconds_bucket{namespace=\"repair-desk\",app=\"api\",route=~\".* /api/.*\"}[$__rate_interval])))",
          "legendFormat": "{{pod}} {{status}}",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": ""
    },
    {
      "id": 6,
      "title": "Доля запросов ≤ 250 мс",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(repairdesk_http_request_duration_seconds_bucket{namespace=\"repair-desk\",app=\"api\",route=~\".* /api/.*\",le=\"0.25\"}[$__rate_interval])) / sum(rate(repairdesk_http_request_duration_seconds_count{namespace=\"repair-desk\",app=\"api\",route=~\".* /api/.*\"}[$__rate_interval]))",
          "legendFormat": "{{pod}} {{status}}",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "SLO 99%; служебные health-пробы исключены."
    },
    {
      "id": 7,
      "title": "SLA пробера: хорошие минуты за 30 дней",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(avg_over_time(min_over_time(repairdesk_probe_success{namespace=\"repair-desk\",app=\"prober\"}[1m])[30d:1m]))",
          "legendFormat": "{{pod}} {{status}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.99
              },
              {
                "color": "green",
                "value": 0.995
              }
            ]
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "description": "Метод ДЗ5: минута хорошая, если все её samples успешны. SLA ≥99%, SLO ≥99.5%. При короткой истории значение относится только к имеющимся данным; см. покрытие."
    },
    {
      "id": 8,
      "title": "Покрытие истории пробера за 30 дней",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(count_over_time(min_over_time(repairdesk_probe_success{namespace=\"repair-desk\",app=\"prober\"}[1m])[30d:1m])) / 43200",
          "legendFormat": "{{pod}} {{status}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "description": "Доля минут окна, для которых есть данные. Пропуски не следует считать доказанной доступностью."
    },
